{
  "permissions": {
    "allow": [
      "Bash(scripts/approve-copyright-review.sh)"
    ],
    "deny": [
      "Bash(git *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git -c *)",
      "Bash(git config*core.hooksPath*)",
      "Edit(.git/copyright-review-approved)",
      "Edit(.git/info/copyright-denylist)",
      "Edit(scripts/approve-copyright-review.sh)"
    ]
  }
}
