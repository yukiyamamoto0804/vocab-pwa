    {
      "file": "demo-examples-2-1.m4a",
      "bitrate": "24k",
      "sha256": "9c8fe6c059e7c7b4eb9da49beec66b23d81bff2e2100efcfca0f00b19fb50c43",
      "duration": 38.44,
      "entries": [
        {
          "id": "ngsl-1021",
          "sense": 1,
          "text": "Put on a warm coat, because the wind by the lake gets cold after dark.",
          "start": 0.25,
          "end": 4.5
        },
        {
          "id": "ngsl-1021",
          "sense": 2,
          "text": "Our new neighbors gave us a warm welcome and a basket of fresh apples.",
          "start": 4.68,
          "end": 8.96
        },
        {
          "id": "ngsl-1021",
          "sense": 3,
          "text": "She warmed her hands over the small fire while waiting for her brother.",
          "start": 9.12,
          "end": 12.86
        },
        {
          "id": "ngsl-1022",
          "sense": 1,
          "text": "The teacher counted the students twice before the bus left the zoo.",
          "start": 13.04,
          "end": 16.76
        },
        {
          "id": "ngsl-1022",
          "sense": 2,
          "text": "What counts most in a job interview is being honest about yourself.",
          "start": 16.94,
          "end": 20.92
        },
        {
          "id": "ngsl-1023",
          "sense": 1,
          "text": "Police officers arrived at the scene a few minutes after the accident.",
          "start": 21.1,
          "end": 25.14
        },
        {
          "id": "ngsl-1023",
          "sense": 2,
          "text": "My favorite scene in the movie is when the two sisters finally meet again.",
          "start": 25.32,
          "end": 29.51
        },
        {
          "id": "ngsl-1024",
          "sense": 1,
          "text": "The writer spent three years living in the mountains to finish her first novel.",
          "start": 29.69,
          "end": 33.89
        },
        {
          "id": "ngsl-1025",
          "sense": 1,
          "text": "The customs officer asked me to open my bag and show its contents.",
          "start": 34.07,
          "end": 38.32
        }
      ]
    },
    {
      "file": "demo-examples-2-2.m4a",
      "bitrate": "24k",
      "sha256": "430760492f394655e17cc3c3aaa2b638e1349046d61dbfabe3af1a72744a1a9e",
      "duration": 39.98,
      "entries": [
        {
          "id": "ngsl-1025",
          "sense": 2,
          "text": "My grandmother is content with a quiet life and her small vegetable garden.",
          "start": 0.25,
          "end": 5.04
        },
        {
          "id": "ngsl-1026",
          "sense": 1,
          "text": "A thin layer of oil on the blade will prevent the knife from rusting.",
          "start": 5.22,
          "end": 9.07
        },
        {
          "id": "ngsl-1027",
          "sense": 1,
          "text": "Is the old wooden bridge safe to cross, or should we take the long way?",
          "start": 9.25,
          "end": 13.45
        },
        {
          "id": "ngsl-1027",
          "sense": 2,
          "text": "The hotel room has a small safe for passports and other valuable items.",
          "start": 13.63,
          "end": 18.14
        },
        {
          "id": "ngsl-1028",
          "sense": 1,
          "text": "We invited all our neighbors to a barbecue in the backyard on Sunday.",
          "start": 18.31,
          "end": 22.43
        },
        {
          "id": "ngsl-1028",
          "sense": 2,
          "text": "The coach's surprising choice of players is sure to invite criticism from fans.",
          "start": 22.6,
          "end": 27.66
        },
        {
          "id": "ngsl-1029",
          "sense": 1,
          "text": "Mix the blue and yellow paint, and you will get a bright green.",
          "start": 27.83,
          "end": 31.28
        },
        {
          "id": "ngsl-1029",
          "sense": 2,
          "text": "The music at the party was a mix of old jazz and modern pop.",
          "start": 31.45,
          "end": 35.27
        },
        {
          "id": "ngsl-1030",
          "sense": 1,
          "text": "Trust is an important element of any friendship that lasts for many years.",
          "start": 35.45,
          "end": 39.86
        }
      ]
    },
    {
      "file": "demo-examples-2-3.m4a",
      "bitrate": "24k",
      "sha256": "d6f6109ce69c0961f74df2f05c9be77305e70dea1c9b0498bcd40fbf9ae739e7",
      "duration": 38.49,
      "entries": [
        {
          "id": "ngsl-1030",
          "sense": 2,
          "text": "Each student chose one element from the periodic table and gave a short talk.",
          "start": 0.25,
          "end": 4.96
        },
        {
          "id": "ngsl-1031",
          "sense": 1,
          "text": "Short daily practice is more effective than one long lesson each week.",
          "start": 5.14,
          "end": 9.52
        },
        {
          "id": "ngsl-1032",
          "sense": 1,
          "text": "Please check that the phone number you wrote on the form is correct.",
          "start": 9.7,
          "end": 13.28
        },
        {
          "id": "ngsl-1032",
          "sense": 2,
          "text": "My friend kindly corrected the spelling mistakes in my English email.",
          "start": 13.45,
          "end": 17.68
        },
        {
          "id": "ngsl-1033",
          "sense": 1,
          "text": "Thanks to medical progress, many illnesses that were once deadly can now be cured.",
          "start": 17.87,
          "end": 22.91
        },
        {
          "id": "ngsl-1034",
          "sense": 1,
          "text": "He finally admitted that he had forgotten to lock the back door.",
          "start": 23.08,
          "end": 26.75
        },
        {
          "id": "ngsl-1034",
          "sense": 2,
          "text": "Children under twelve are admitted free when they come with an adult.",
          "start": 26.92,
          "end": 30.77
        },
        {
          "id": "ngsl-1035",
          "sense": 1,
          "text": "The little boy happily beat his toy drum while his father sang.",
          "start": 30.94,
          "end": 34.48
        },
        {
          "id": "ngsl-1035",
          "sense": 2,
          "text": "For a fluffy omelet, beat three eggs with a little cold water.",
          "start": 34.66,
          "end": 38.36
        }
      ]
    },
    {
      "file": "demo-examples-2-4.m4a",
      "bitrate": "24k",
      "sha256": "4a1b959c5539a687219d0847fd13f0949a8cbebcce752bf22338ed4de8faf964",
      "duration": 33.88,
      "entries": [
        {
          "id": "ngsl-1035",
          "sense": 3,
          "text": "My heart was beating fast as I walked onto the stage for the first time.",
          "start": 0.25,
          "end": 4.43
        },
        {
          "id": "ngsl-1036",
          "sense": 1,
          "text": "There is an old black telephone on the desk in my grandfather's study.",
          "start": 4.6,
          "end": 8.62
        },
        {
          "id": "ngsl-1036",
          "sense": 2,
          "text": "I telephoned the clinic to ask if they were open on holidays.",
          "start": 8.79,
          "end": 12.32
        },
        {
          "id": "ngsl-1037",
          "sense": 1,
          "text": "The library has only one copy of the book, so I had to wait.",
          "start": 12.49,
          "end": 16.17
        },
        {
          "id": "ngsl-1037",
          "sense": 2,
          "text": "Please copy the words on the board into your notebook before class ends.",
          "start": 16.34,
          "end": 20.29
        },
        {
          "id": "ngsl-1038",
          "sense": 1,
          "text": "The town committee will decide next month where to build the new playground.",
          "start": 20.46,
          "end": 24.47
        },
        {
          "id": "ngsl-1039",
          "sense": 1,
          "text": "Were you aware that the library closes early on the last Friday of each month?",
          "start": 24.64,
          "end": 29.0
        },
        {
          "id": "ngsl-1040",
          "sense": 1,
          "text": "My older sister gave me useful advice before my first job interview.",
          "start": 29.18,
          "end": 33.76
        }
      ]
    }
  ]
