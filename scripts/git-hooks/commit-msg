#!/bin/sh
# コミットメッセージに禁止語リスト（.git/info/copyright-denylist、非公開）の語が含まれていないか確認する
set -eu

# worktree からでも見つかるよう、共通の Git フォルダで探す。ないときは、確かめずに通さずに止める
denylist="$(git rev-parse --git-common-dir)/info/copyright-denylist"
if [ ! -f "$denylist" ]; then
  printf '\n[著作権チェック] コミットを中止しました: 禁止語リスト（%s）がありません。語がなければ空のファイルを作ってください\n\n' "$denylist" >&2
  exit 1
fi

patterns=$(mktemp)
trap 'rm -f "$patterns"' EXIT
grep -vE '^[[:space:]]*(#|$)' "$denylist" > "$patterns" || true
[ -s "$patterns" ] || exit 0

hits=$(grep -v '^#' "$1" | grep -inF -f "$patterns" || true)
if [ -n "$hits" ]; then
  printf '%s\n' "$hits" >&2
  printf '\n[著作権チェック] コミットを中止しました: コミットメッセージに禁止語リストの語が含まれています\n\n' >&2
  exit 1
fi

exit 0
